<table class="w-full text-sm bg-white rounded-xl overflow-hidden">

    <thead class="bg-gray-50 text-gray-600">
        <tr>
            <th data-action="click->sort#sort" data-column="name" class="p-4 text-start cursor-pointer">Name</th>
            <th data-action="click->sort#sort" data-column="role" class="p-4 cursor-pointer">Role</th>
            <th data-action="click->sort#sort" data-column="status" class="p-4 cursor-pointer">Status</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>

    <tbody>
    <% if @users.present? %>
        <% @users.each do |user| %>

        <tr class="border-t border-l-4 border-gray-50 hover:bg-gray-50 transition" data-sort-target="row" data-search-target="row" data-name="<%= user.firstname %>" data-role="<%= user.role %>" data-status="<%= user.status %>">

            <td class="px-4 py-3">
                <%= user.firstname %> <%= user.lastname %>
            </td>

            <td class="text-center">
                <span class="badge <%= user.admin? ? 'role-admin' : 'role-user' %>">
                    <%= user.role %>
                </span>
            </td>

            <td class="text-center">
                <span class="
                    <%= case user.status
                    when "active"
                    "px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs"
                    when "inactive"
                    "badge-inactive"
                    else
                    "px-2 py-1 bg-red-100 text-red-600 rounded-full text-xs"
                    end %>">

                    <%= user.status.capitalize %>

                </span>
            </td>

            <td class="flex justify-center gap-4 py-3 text-crystal">

                <%= link_to edit_backend_user_path(user), class: "text-[#1A3C6D] hover:text-blue-800 inline-flex" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                    </svg>
                <% end %>

                <%= link_to backend_user_path(user), class: "text-[#1A3C6D] hover:text-blue-800 inline-flex", data:{controller:"confirm",action:"click->confirm#confirm"} do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                <% end %>
            </td>

        </tr>

        <% end %>
    <% else %>
        <tr class="border-t hover:bg-gray-50 transition text-center">
            <td class="p-4" colspan="7">ไม่พบข้อมูลผู้ใช้</td>
        </tr>
    <% end %>

    </tbody>

</table>

<div class="p-4">
    <div class="flex items-center justify-between p-4 text-sm text-gray-500">

        <div>
            แสดง
            <%= @users.offset_value + 1 %> -
            <%= [@users.offset_value + @users.limit_value, @users.total_count].min %>
            จาก <%= @users.total_count %> รายการ
        </div>

        <div>
            <%= paginate @users, params: request.query_parameters %>
        </div>

    </div>
</div>

<div class="md:hidden space-y-4">
    <% if @users.present? %>
        <% @users.each do |user| %>

            <div class="bg-royalnavy rounded-lg p-4">
                <div class="flex justify-between">
                    <div>
                        <div class="text-gold font-semibold">
                            <%= user.firstname %> <%= user.lastname %>
                            <span class="ml-4 text-sm badge <%= user.admin? ? 'role-admin' : 'role-user' %>">
                                <%= user.role %>
                            </span>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <%= link_to edit_backend_user_path(user) do %>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        <% end %>
                        <%= link_to backend_user_path(user), data:{controller:"confirm",action:"click->confirm#confirm", menu: "user"} do %>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        <% end %>
                    </div>

                </div>

                <div class="text-sm mt-2">Status :
                    <span class="
                        <%= case user.status
                        when "active"
                        "px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs"
                        when "inactive"
                        "badge-inactive"
                        else
                        "px-2 py-1 bg-red-100 text-red-600 rounded-full text-xs"
                        end %>">

                        <%= user.status.capitalize %>

                    </span>
                </div>

            </div>
        <% end %>
    <% end %>
</div>
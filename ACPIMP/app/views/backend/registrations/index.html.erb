<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

    <h1 class="text-2xl font-semibold mb-6 text-[#1A3C6D]">
        ผู้สมัครทั้งหมด
    </h1>

    <!-- Tabs -->
    <div class="flex gap-2">
        <% ["500","600"].each do |type| %>
            <% type_name = type == "500" ? "Online" : "Onsite"%>
            <%= link_to type_name, backend_registrations_path(competition_type: type), class: "tab-btn #{params[:competition_type] == type || (params[:competition_type].blank? && type_name == "Online") ? 'tab-active' : ''}" %>
        <% end %>
    </div>
</div>

<div>
    <div data-controller="filter">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden mb-3">
            <%= render partial: "filter" %>
        </div>

        <div class="bg-white rounded-xl shadow-lg overflow-hidden" data-filter-target="result">
            <%= render "table" %>
        </div>
    </div>
</div>
<% flash.each do |type,message| %>
    <div data-controller="flash" class="fixed top-5 right-5 z-50 ">
        <div class="px-6 py-3 rounded-lg shadow-xl
            <% if type == "success" %>
                bg-green-500 text-green-300 border border-green-400
            <% else %>
                bg-red-500 text-red-300 border border-red-400
            <% end %>">
            <%= message %>
        </div>
    </div>
<% end %>
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
        </button>
    </div>

    <nav class="space-y-2">

        <%= link_to backend_dashboard_path(), class: "block px-4 py-2 hover:bg-royalnavy" do %>

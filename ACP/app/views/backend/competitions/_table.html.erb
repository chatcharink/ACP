<table class="w-full text-sm">

    <thead class="bg-gray-50 sticky top-0 z-10">
        <tr>

            <th class="p-3 w-[2rem]"><input type="checkbox" id="select-all" data-action="change->bulk#toggleAll"></th>
            <th class="p-3 w-[6rem]"></th>
            <th class="p-3 text-left">ชื่อ</th>
            <th class="p-3">รหัสผู้เข้าแข่งขัน</th>
            <th class="p-3">รุ่น</th>
            <th class="p-3 cursor-pointer">คะแนน</th>
            <% unless session[:role] == "user" %>
                <th class="p-3">รางวัล</th>
            <% end %>
            <th class="p-3">สถานะ</th>
            <th class="p-3">Action</th>

        </tr>
    </thead>

    <tbody>
        <% if @registrations.blank? %>
            <tr class="border-t hover:bg-gray-50 transition text-center">
                <td class="p-4" colspan="8">ไม่พบข้อมูลผู้แข่งขัน</td>
            </tr>
        <% else %>
            <% @registrations.each_with_index do |r, i| %>
                <tr class="border-t hover:bg-gray-50 <%= 'bg-yellow-50' if i < 5 %>">

                    <td class="p-3 w-[2rem] text-center"><input type="checkbox" name="registration_ids[]" value="<%= r.id %>" data-action="change->bulk#toggle_checkbox" data-bulk-target="item"></td>

                    <td class="p-3 w-[6rem]">
                        <%= image_tag r.image, class:"w-16 h-16 object-cover rounded-full" if r.image.attached? %>
                    </td>

                    <td class="p-3 font-medium"><%= r.name_th %></td>

                    <td class="p-3 text-center"><%= r.code %></td>

                    <td class="p-3 text-center"><%= r.category %></td>

                    <td class="p-3 text-center font-bold text-[#1A3C6D]">
                        <%= r.total_score %>
                    </td>

                    <% unless session[:role] == "user" %>
                        <td class="p-3 text-center">
                            <% award = award_by_score(r.total_score) %>

                            <span class="px-2 py-1 text-xs rounded-full
                                <%= case award
                                when "Gold" then "bg-yellow-100 text-yellow-700"
                                when "Silver" then "bg-gray-200 text-gray-700"
                                when "Bronze" then "bg-orange-100 text-orange-700"
                                else "bg-gray-100 text-gray-400"
                                end %>">

                                <%= award %>
                            </span>
                        </td>
                    <% end %>

                    <td class="p-3 text-center">
                        <span class="
                            <%= r.competition_status == 'completed' ? 'bg-green-100 text-green-600' : 'bg-yellow-100 text-yellow-600' %>
                            px-2 py-1 rounded text-xs
                            ">
                            <%= r.competition_status == 'completed' ? 'แข่งขันแล้ว' : 'ยังไม่แข่งขัน' %>
                        </span>
                    </td>

                    <td class="p-3 flex gap-2 justify-center mt-[20px]">

                        <% if session[:role] == "user" %>
                            <% has_score = Score.exists?(registration_id: r.id, user_id: session[:user_id]) %>

                            <% if has_score %>
                                <%= link_to edit_backend_competition_path(id: r.id), class:"btn-icon" do %>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                                    </svg>
                                <% end %>
                            <% else %>
                                <%= link_to new_backend_competition_path(registration_id: r.id), class:"btn-icon" do %>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                                    </svg>
                                <% end %>
                            <% end %>
                        <% else %>
                            <%= link_to comment_template_backend_competition_path(r), class:"btn-icon" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                                </svg>
                            <% end %>

                            <%= link_to admin_edit_backend_competition_path(r), class:"btn-icon" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                                </svg>
                            <% end %>
                        <% end %>

                        <% unless session[:role] == "user" %>
                            <%= link_to score_pdf_backend_competition_path(r), class:"btn-icon" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
                                </svg>
                            <% end %>

                            <%= link_to certificate_backend_competition_path(r), class:"btn-icon" do %>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
                                </svg>
                            <% end %>
                        <% end %>
                    </td>

                </tr>
            <% end %>
        <% end %>

    </tbody>
</table>
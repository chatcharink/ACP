<div data-controller="competition" class="max-w-3xl mx-auto">

    <div class="bg-white rounded-2xl shadow p-6 text-center flex flex-col items-center mb-4">

        <!-- รูป -->
        <% if @registration.image.attached? %>
            <%= image_tag @registration.image,
                class: "w-32 h-32 md:w-40 md:h-40 rounded-full object-cover shadow-lg mb-3" %>
        <% else %>
            <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gray-200 flex items-center justify-center text-gray-400 mb-3">
            +
            </div>
        <% end %>

        <!-- ชื่อ -->
        <div class="text-lg md:text-xl font-semibold text-gray-800">
            <%= @registration.name_th %>
        </div>

        <!-- รายละเอียด -->
        <div class="text-sm text-gray-500 mt-1">
            <%= @registration.category %>
        </div>

    </div>

    <!-- Rubric -->
    <div class="bg-white p-4 rounded-xl shadow mb-4">
        <form action="<%= backend_competitions_path %>" method="post" enctype="multipart/form-data">
            <%= hidden_field_tag :registration_id, @registration.id %>

            <div class="space-y-4">

                <% @categories.each do |c| %>
                    <% score = @scores.find { |s| s.score_category_id == c.id } %>

                    <div class="flex items-center justify-between gap-3">

                        <div class="flex-1">
                            <div class="text-sm md:text-base font-medium">
                                <%= c.name %>
                            </div>
                            <div class="text-xs text-gray-400">
                                เต็ม <%= c.max_score %>
                            </div>
                        </div>

                        <input type="number"
                        name="scores[][value]"
                        value="<%= score&.value || '0' %>"
                        data-action="input->competition#update"
                        data-max="<%= c.max_score %>"
                        class="w-20 md:w-24 h-10 md:h-12 text-center rounded-lg border border-gray-300 text-base"
                        min="0"
                        max="<%= c.max_score %>">

                        <!-- 🔥 สำคัญ -->
                        <input type="hidden"
                        name="scores[][category_id]"
                        value="<%= c.id %>">

                    </div>
                <% end %>

            </div>

            <!-- Total -->
            <div class="pt-4 mt-4 border-t flex items-center justify-between mb-4">

                <div class="text-base md:text-lg font-semibold text-gray-700">
                    Total Score
                </div>

                <div class="text-xl md:text-2xl font-bold text-[#1A3C6D]">
                    <span data-competition-target="total">0</span>
                </div>

            </div>

            <% main_score = @scores.first %>

            <!-- Comment -->
            <label for="comment" class="text-base">Comment: </label>
            <textarea name="comment" id="comment" placeholder="Comment..." class="input-clean w-full"><%= main_score&.comment || '' %></textarea>

            <div class="mt-3">

                <div class="mb-2">
                    <% if main_score&.comment_file&.attached? %>
                        <%= image_tag main_score.comment_file, data: { competition_target: "image" }, class: "w-full mx-auto rounded-lg object-cover shadow" %>
                    <% else %>
                        <img data-competition-target="image" class="w-full mx-auto rounded-lg object-cover shadow hidden">
                    <% end %>
                </div>

                <label class="block cursor-pointer border-2 border-dashed border-gray-300 rounded-xl p-4 text-center hover:border-blue-500 transition">

                    <!-- text -->
                    <div class="text-sm text-gray-600">
                        คลิกเพื่ออัปโหลด Comment
                    </div>

                    <div class="text-xs text-gray-400" data-competition-target="filename">
                        Support PNG, JPG, JPEG
                    </div>

                    <!-- hidden input -->
                    <input type="file" name=file accept="image/*" class="hidden" data-action="change->competition#show" />

                    </div>

                </label>

            </div>

            <!-- Submit -->
            <button class="w-full mt-4 py-3 md:py-4 text-base md:text-lg font-semibold rounded-xl
                bg-[#1A3C6D] text-white shadow hover:opacity-90 transition cursor-pointer">
                บันทึกคะแนน
            </button>

        </form>
    </div>

</div>
<div class="bg-white rounded-xl shadow overflow-hidden">

    <table class="w-full text-sm">

    <thead class="bg-gray-50 text-gray-600">
        <tr>

        <th class="p-3">
            <input type="checkbox" data-action="change->competition#toggleAll">
        </th>

        <th class="p-3 text-left">รูป</th>

        <th class="p-3 text-left cursor-pointer"
            data-action="click->competition#sort"
            data-sort="name">
            <div class="flex justify-between">
            ชื่อ
            <span>↕</span>
            </div>
        </th>

        <th class="p-3">รางวัล</th>

        <th class="p-3">สถานะ</th>

        <th class="p-3 text-center">Action</th>

        </tr>
    </thead>

    <tbody>

        <% registrations.each do |r| %>
        <tr class="<%= index < 5 ? 'bg-yellow-50 font-semibold' : 'border-t hover:bg-gray-50' %>">

            <!-- checkbox -->
            <td class="p-3">
            <input type="checkbox" value="<%= r.id %>">
            </td>

            <!-- image -->
            <td class="p-3">
            <% if r.image.attached? %>
                <%= image_tag r.image, class: "w-10 h-10 rounded-full object-cover" %>
            <% else %>
                <div class="w-10 h-10 bg-gray-200 rounded-full"></div>
            <% end %>
            </td>

            <!-- name -->
            <td class="p-3 font-medium text-gray-800">
            <%= r.name_th %>
            </td>

            <!-- award -->
            <td class="p-3">
            <span class="px-2 py-1 text-xs rounded-full
                <%# award_color(r.award) %>">
                <%# r.award || "-" %>
                -
            </span>
            </td>

            <!-- status -->
            <td class="p-3">
            <span class="px-2 py-1 text-xs rounded-full
                <%= status_color(r.status) %>">
                <%= status_label(r.status) %>
            </span>
            </td>

            <!-- actions -->
            <td class="p-3 text-center flex justify-center gap-2">

            <%= link_to "📄",
                score_pdf_backend_competition_path(r),
                class: "btn-icon" %>

            <%= link_to "⭐",
                score_backend_competition_path(r),
                class: "btn-icon bg-yellow-400/20 text-yellow-600" %>

            <%= link_to "🏆",
                certificate_backend_competition_path(r),
                class: "btn-icon bg-blue-400/20 text-blue-600" %>

            </td>

        </tr>
        <% end %>

    </tbody>

    </table>

</div>
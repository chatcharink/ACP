<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

    <h1 class="text-2xl font-semibold text-[#1A3C6D]">
        การแข่งขัน
    </h1>

    <!-- Tabs -->
    <div class="flex gap-2">
        <% ["500","600"].each do |type| %>
            <% type_name = type == "500" ? "Online" : "Onsite"%>
            <%= link_to type_name, backend_competitions_path(competition_type: type), class: "tab-btn #{params[:competition_type] == type || (params[:competition_type].blank? && type_name == "Online") ? 'tab-active' : ''}" %>
        <% end %>
    </div>

</div>

<% unless session[:role] == "user" %>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">

        <div class="card">
            <div class="text-sm text-gray-500">Gold</div>
            <div class="text-xl font-bold text-yellow-600">
            <%= @registrations.count { |r| award_by_score(r.total_score) == "Gold" } %>
            </div>
        </div>

        <div class="card">
            <div class="text-sm text-gray-500">Silver</div>
            <div class="text-xl font-bold text-gray-600">
            <%= @registrations.count { |r| award_by_score(r.total_score) == "Silver" } %>
            </div>
        </div>

        <div class="card">
            <div class="text-sm text-gray-500">Bronze</div>
            <div class="text-xl font-bold text-orange-600">
            <%= @registrations.count { |r| award_by_score(r.total_score) == "Bronze" } %>
            </div>
        </div>

    </div>

<% end %>

<div data-controller="bulk">
    <form data-bulk-target="form" class="bg-white p-4 rounded-xl shadow mb-4 grid grid-cols-2 md:grid-cols-5 gap-3">

        <select name="sort" class="input-clean" data-action="change->bulk#fetch">
            <option value="name">เรียงชื่อ</option>
            <option value="score_desc">คะแนนมาก → น้อย</option>
            <option value="score_asc">คะแนนน้อย → มาก</option>
        </select>

        <input type="text" name="q" value="<%= params[:q] %>" placeholder="ค้นหาชื่อ..." class="input-clean" data-action="input->bulk#fetch">

        <select name="category" class="input-clean" data-action="change->bulk#fetch" >

            <option value="" selected>
                รุ่นทั้งหมด
            </option>
            <% @category_groups.each do |group| %>
                <optgroup label="<%= group.name_th %>" class="font-bold">

                <% group.categories.each do |c| %>
                    <option value="<%= c.code %>" <%= "selected" if params[:category] == c.code %>>
                        <%= c.name_en %>
                    </option>
                <% end %>

                </optgroup>
            <% end %>

        </select>

        <select name="competition_status" class="input-clean" data-action="change->bulk#fetch">
            <option value="">สถานะทั้งหมด</option>
            <option value="completed">แข่งขันแล้ว</option>
            <option value="pending">ยังไม่แข่งขัน</option>
        </select>

        <select name="award" class="input-clean" data-action="change->bulk#fetch">
            <option value="">รางวัลทั้งหมด</option>
            <option value="gold">🥇 Gold</option>
            <option value="silver">🥈 Silver</option>
            <option value="bronze">🥉 Bronze</option>
        </select>

    </form>

    <div class="relative flex justify-end text-left mb-4 hidden" id="btn-select-download">

        <button type="button" class="gold-btn flex items-center gap-2" data-action="click->bulk#toggle">
            ดาวน์โหลด
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>

        </button>

        <!-- dropdown menu -->
        <div data-bulk-target="menu" class="absolute right-0 mt-5 w-48 bg-white rounded-xl shadow-lg hidden z-50">

            <button class="inline-flex w-full text-left px-4 py-2 hover:bg-gray-100" data-action="click->bulk#downloadAll" data-url="<%= bulk_certificate_backend_competitions_path() %>">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
                </svg>เกียรติบัตร
            </button>

            <button class="inline-flex w-full text-left px-4 py-2 hover:bg-gray-100" data-action="click->bulk#downloadAll" data-url="<%= bulk_comment_backend_competitions_path() %>">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 me-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
                </svg>ใบคะแนน
            </button>

        </div>

    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">

        <div id="table-wrapper" data-bulk-target="result">
            <%= render "table" %>
        </div>

    </div>
</div>